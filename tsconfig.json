{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun-types", "node"],
    "verbatimModuleSyntax": true,
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src/**/*.ts", "cli/**/*.ts", "scripts/**/*.ts", "gallery/**/*.ts"]
}
