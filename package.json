{
  "name": "@garkpit/diagrams",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Excalidraw diagrams from a small TypeScript DSL: grid layouts for flowcharts, swim lanes and more, text measured in the real Excalifont, a fit check that automates the visual pass, SVG/PNG/PDF output.",
  "bin": {
    "diagrams": "./cli/diagrams.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "cli",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "docs": "bun scripts/docs.ts",
    "docs:check": "bun scripts/docs.ts --check",
    "gallery": "bun cli/diagrams.ts gallery gallery/scenes.ts --out gallery/out",
    "demo": "bun scripts/demo.ts",
    "pages": "bun scripts/pages.ts",
    "publish": "bun scripts/publish.ts",
    "check": "bun run typecheck && bun run test && bun run docs:check && bun cli/diagrams.ts check gallery/scenes.ts",
    "install:bin": "bun scripts/install-bin.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@happy-dom/global-registrator": "^21.0.4",
    "fontkit": "^2.0.4",
    "marked": "^18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "bun-types": "^1.3.1",
    "typescript": "^7.0.2"
  }
}
